{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime acceptance case record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "prompt_path",
    "oracle_path",
    "run_path",
    "evidence",
    "native_transcript",
    "assessment",
    "assessed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^A-0(0[1-9]|1[0-9]|2[0-7])$"
    },
    "status": {
      "enum": [
        "Pending",
        "Running",
        "Passed",
        "Failed",
        "Blocked"
      ]
    },
    "prompt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "oracle_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_transcript": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
