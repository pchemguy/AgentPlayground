+class FileFailureTests(unittest.TestCase):
+    """Verify standard API errors, silent failure and owned-handle closure."""
+
+    def test_missing_file_preserves_os_error_without_output(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "missing.txt"
+            stdout, stderr = io.StringIO(), io.StringIO()
+            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                with self.assertRaises(FileNotFoundError):
+                    count_file(path)
+            self.assertEqual(stdout.getvalue(), "")
+            self.assertEqual(stderr.getvalue(), "")
+
+    def test_invalid_utf8_preserves_decode_error_and_closes_real_handle(self):
+        handles = []
+
+        def observe_open(*args, **kwargs):
+            handle = builtins.open(*args, **kwargs)
+            handles.append(handle)
+            return handle
+
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "invalid.txt"
+            path.write_bytes(b"valid prefix\n\xff")
+            stdout, stderr = io.StringIO(), io.StringIO()
+            with patch("textstats.files.open", side_effect=observe_open, create=True):
+                with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                    with self.assertRaises(UnicodeDecodeError):
+                        count_file(path)
+            self.assertTrue(handles)
+            self.assertTrue(all(handle.closed for handle in handles))
+            self.assertEqual(path.read_bytes(), b"valid prefix\n\xff")
+            self.assertEqual(stdout.getvalue(), "")
+            self.assertEqual(stderr.getvalue(), "")
+
+    def test_open_permission_error_retains_exception_identity(self):
+        denied = PermissionError("permission denied")
+        with patch("textstats.files.open", side_effect=denied, create=True):
+            with self.assertRaises(PermissionError) as raised:
+                count_file("denied.txt")
+        self.assertIs(raised.exception, denied)
+
+    def test_read_failure_closes_real_handle_and_retains_os_error(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "sample.txt"
+            path.write_bytes(b"alpha beta")
+            handle = builtins.open(path, encoding="utf-8")
+            failure = OSError("simulated device read failure")
+            try:
+                with patch.object(handle, "read", side_effect=failure):
+                    with patch("textstats.files.open", return_value=handle, create=True):
+                        with self.assertRaises(OSError) as raised:
+                            count_file(path)
+                self.assertIs(raised.exception, failure)
+                self.assertTrue(handle.closed)
+            finally:
+                handle.close()
