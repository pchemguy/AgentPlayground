+class BaselineFailureCliTests(CliProcessChecks, unittest.TestCase):
+    """Check error/usage channels and actual filesystem permission denial."""
+
+    def assert_read_failure(self, result, input_name, cause):
+        """Require a useful named diagnostic without success output/traceback."""
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertIn(str(input_name), result.stderr)
+        self.assertIn(cause, result.stderr.lower())
+        self.assertNotIn("Traceback", result.stderr)
+
+    def test_missing_malformed_and_directory_inputs(self):
+        with tempfile.TemporaryDirectory() as directory:
+            missing = Path(directory) / "missing.txt"
+            invalid = Path(directory) / "invalid.txt"
+            invalid.write_bytes(b"alpha\n\xff")
+            for path, cause in [(missing, "no such file"), (invalid, "utf-8"),
+                                (Path(directory), "directory")]:
+                with self.subTest(path=path):
+                    self.assert_read_failure(self.run_cli(path), path, cause)
+
+    def test_invalid_invocations_use_usage_status_and_channels(self):
+        for arguments in ([], ["first", "second"], ["--unknown", "file"], ["--keep-bom"]):
+            with self.subTest(arguments=arguments):
+                result = self.run_command(arguments)
+                self.assertEqual(result.returncode, 2)
+                self.assertEqual(result.stdout, "")
+                self.assertTrue(result.stderr.strip())
+                self.assertNotIn("Traceback", result.stderr)
+
+    def test_help_succeeds_without_stderr(self):
+        result = self.run_command(["--help"])
+        self.assertEqual(result.returncode, 0)
+        self.assertTrue(result.stdout.strip())
+        self.assertIn("--keep-bom", result.stdout)
+        self.assertEqual(result.stderr, "")
+
+    def test_double_dash_supports_dash_prefixed_filename(self):
+        with tempfile.TemporaryDirectory() as directory:
+            (Path(directory) / "-sample.txt").write_bytes(b"alpha beta\n")
+            self.assert_success(self.run_command(["--", "-sample.txt"], cwd=directory),
+                                "lines=1 words=2\n")
+
+    def test_permission_denial_at_real_file_open_boundary(self):
+        # This privileged runner cannot change its child's UID/GID. A controlled
+        # EACCES at open supplements the real missing/malformed file subprocesses.
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "denied.txt"
+            path.write_bytes(b"alpha beta\n")
+            denied = PermissionError(errno.EACCES, os.strerror(errno.EACCES), str(path))
+            stdout, stderr = io.StringIO(), io.StringIO()
+            with patch("textstats.files.open", side_effect=denied, create=True):
+                with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                    status = main([str(path)])
+            self.assertEqual(status, 1)
+            self.assertEqual(stdout.getvalue(), "")
+            self.assertIn(str(path), stderr.getvalue())
+            self.assertIn("permission denied", stderr.getvalue().lower())
+            self.assertNotIn("Traceback", stderr.getvalue())
+            self.assertEqual(path.read_bytes(), b"alpha beta\n")
